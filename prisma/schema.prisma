generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SYSTEM_ADMIN
  ISSUER_ADMIN
  HOLDER
  VERIFIER_ADMIN
}

enum OrganizationType {
  UNIVERSITY
  BANK
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum DidOwnerType {
  ORGANIZATION
  USER
}

enum DidStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AcademicRecordStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  INVALID
}

enum CredentialStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum TrustedIssuerStatus {
  TRUSTED
  SUSPENDED
  REVOKED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum EducationVerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  VERIFIED
  FAILED
}

enum VerificationFinalResult {
  VERIFIED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  refreshTokens                RefreshToken[]
  organizationMemberships      OrganizationMember[]
  academicRecords              AcademicRecord[]
  credentials                  Credential[]
  walletCredentials            WalletCredential[]
  approvedTrustedIssuers       TrustedIssuer[]           @relation("TrustedIssuerApprover")
  credentialStatusChanges      CredentialStatusHistory[] @relation("CredentialStatusChangedBy")
  applications                 Application[]
  verificationRequestsCreated  VerificationRequest[]     @relation("VerificationRequestVerifier")
  verificationRequestsReceived VerificationRequest[]     @relation("VerificationRequestHolder")
  presentations                Presentation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id      String             @id @default(uuid())
  name    String
  slug    String             @unique
  type    OrganizationType
  email   String?
  website String?
  status  OrganizationStatus @default(ACTIVE)

  members                    OrganizationMember[]
  academicRecords            AcademicRecord[]
  credentialSchemas          CredentialSchema[]
  issuedCredentials          Credential[]
  trustedIssuerRegistrations TrustedIssuer[]
  jobs                       Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String @id @default(uuid())
  organizationId String
  userId         String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Did {
  id                  String       @id @default(uuid())
  did                 String       @unique
  ownerType           DidOwnerType
  ownerId             String
  publicKey           String
  encryptedPrivateKey String
  iv                  String
  authTag             String
  algorithm           String       @default("Ed25519")
  keyVersion          Int          @default(1)
  status              DidStatus    @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerType, ownerId])
  @@index([status])
}

model AcademicRecord {
  id             String               @id @default(uuid())
  universityId   String
  holderId       String
  studentId      String
  fullName       String
  degree         String
  department     String?
  major          String
  cgpa           Decimal?
  graduationYear Int
  graduationDate DateTime?
  status         AcademicRecordStatus @default(ACTIVE)

  credentials Credential[]

  university Organization @relation(fields: [universityId], references: [id], onDelete: Restrict)
  holder     User         @relation(fields: [holderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, studentId])
  @@index([universityId])
  @@index([holderId])
  @@index([status])
}

model CredentialSchema {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  version        String
  description    String?
  schemaJson     Json
  status         String  @default("ACTIVE")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  credentials Credential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([status])
}

model Credential {
  id                   String           @id @default(uuid())
  vcId                 String           @unique
  issuerOrganizationId String
  issuerDid            String
  holderId             String
  holderDid            String
  schemaId             String
  academicRecordId     String
  credentialHash       String
  status               CredentialStatus @default(ACTIVE)
  issuedAt             DateTime
  expiresAt            DateTime?

  issuerOrganization Organization      @relation(fields: [issuerOrganizationId], references: [id], onDelete: Restrict)
  holder             User              @relation(fields: [holderId], references: [id], onDelete: Restrict)
  schema             CredentialSchema  @relation(fields: [schemaId], references: [id], onDelete: Restrict)
  academicRecord     AcademicRecord    @relation(fields: [academicRecordId], references: [id], onDelete: Restrict)
  walletCredential   WalletCredential?

  statusHistory CredentialStatusHistory[]
  presentations Presentation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issuerOrganizationId])
  @@index([holderId])
  @@index([schemaId])
  @@index([academicRecordId])
  @@index([status])
}

model WalletCredential {
  id           String @id @default(uuid())
  holderId     String
  credentialId String @unique

  ciphertext String
  iv         String
  authTag    String

  holder     User       @relation(fields: [holderId], references: [id], onDelete: Restrict)
  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([holderId])
}

model TrustedIssuer {
  id             String              @id @default(uuid())
  organizationId String
  issuerDid      String              @unique
  status         TrustedIssuerStatus @default(TRUSTED)
  approvedBy     String
  approvedAt     DateTime            @default(now())
  suspendedAt    DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  approvedByUser User         @relation("TrustedIssuerApprover", fields: [approvedBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([approvedBy])
}

model CredentialStatusHistory {
  id             String           @id @default(uuid())
  credentialId   String
  previousStatus CredentialStatus
  newStatus      CredentialStatus
  reason         String?
  changedBy      String

  credential    Credential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  changedByUser User       @relation("CredentialStatusChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([credentialId])
  @@index([changedBy])
  @@index([newStatus])
  @@index([createdAt])
}

model Job {
  id             String  @id @default(uuid())
  bankId         String
  title          String
  description    String?
  requiredClaims Json
  status         String  @default("OPEN")

  bank         Organization  @relation(fields: [bankId], references: [id], onDelete: Restrict)
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bankId])
  @@index([status])
}

model Application {
  id                          String                      @id @default(uuid())
  jobId                       String
  holderId                    String
  status                      ApplicationStatus           @default(DRAFT)
  educationVerificationStatus EducationVerificationStatus @default(NOT_VERIFIED)
  verifiedAcademicData        Json?

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  holder User @relation(fields: [holderId], references: [id], onDelete: Restrict)

  verificationRequests VerificationRequest[]
  verificationResults  VerificationResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([holderId])
  @@index([status])
  @@index([educationVerificationStatus])
}

model VerificationRequest {
  id              String                    @id @default(uuid())
  applicationId   String
  verifierId      String
  holderId        String
  requestedClaims Json
  nonceHash       String
  status          VerificationRequestStatus @default(PENDING)
  expiresAt       DateTime

  application  Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  verifier     User          @relation("VerificationRequestVerifier", fields: [verifierId], references: [id], onDelete: Restrict)
  holder       User          @relation("VerificationRequestHolder", fields: [holderId], references: [id], onDelete: Restrict)
  presentation Presentation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([verifierId])
  @@index([holderId])
  @@index([status])
  @@index([expiresAt])
}

model Presentation {
  id               String @id @default(uuid())
  requestId        String @unique
  credentialId     String
  holderId         String
  holderDid        String
  disclosedClaims  Json
  nonce            String
  presentationHash String
  holderProof      Json

  request            VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  credential         Credential          @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  holder             User                @relation(fields: [holderId], references: [id], onDelete: Restrict)
  verificationResult VerificationResult?

  createdAt DateTime @default(now())

  @@index([credentialId])
  @@index([holderId])
  @@index([createdAt])
}

model VerificationResult {
  id             String @id @default(uuid())
  presentationId String @unique
  applicationId  String

  requestValid          Boolean
  nonceValid            Boolean
  holderProofValid      Boolean
  hashValid             Boolean
  issuerSignatureValid  Boolean
  issuerTrusted         Boolean
  credentialStatusValid Boolean
  schemaValid           Boolean
  holderMatches         Boolean
  claimsValid           Boolean

  finalResult   VerificationFinalResult
  failureReason String?
  verifiedAt    DateTime                @default(now())

  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([finalResult])
  @@index([verifiedAt])
}

model AuditLog {
  id             String  @id @default(uuid())
  actorId        String?
  organizationId String?
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
