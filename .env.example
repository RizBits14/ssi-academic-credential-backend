# Application
NODE_ENV=development
PORT=3000

# Runtime database connection.
# For remote PostgreSQL, use sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=verify-full

# Direct database connection for Prisma migrations.
# Prefer the direct db.prisma.io URL from the Prisma Console.
DIRECT_URL=postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=verify-full

# JWT
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Development/seed only.
SEED_DEFAULT_PASSWORD=REPLACE_WITH_A_LOCAL_SEED_PASSWORD

# Legacy encryption key retained for rows with encryptionKeyId = null.
MASTER_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Redis
# Local development may use redis://.
# Production must use rediss://.
REDIS_URL=redis://localhost:6379

# CORS
# Development example:
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Swagger must be false in production.
SWAGGER_ENABLED=true

E2E_ALLOW_DATABASE_MUTATIONS=false

# DID encryption domain
DID_ENCRYPTION_ACTIVE_KEY_ID=v1
DID_ENCRYPTION_KEY_V1=REPLACE_WITH_64_HEX_CHARACTERS

# Wallet encryption domain
WALLET_ENCRYPTION_ACTIVE_KEY_ID=v1
WALLET_ENCRYPTION_KEY_V1=REPLACE_WITH_A_DIFFERENT_64_HEX_VALUE
