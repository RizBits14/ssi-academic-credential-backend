{
    "name": "ssi-academic-credential-platform",
    "version": "1.0.0",
    "private": true,
    "description": "SSI-based academic credential issuance and verification platform",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev:api": "npm run start:dev --workspace=apps/api",
        "build:api": "npm run build --workspace=apps/api",
        "test:api": "npm run test --workspace=apps/api",
        "verify:api": "npm run verify --workspace=apps/api"
    },
    "overrides": {
        "@nestjs/platform-express": {
            "multer": "2.5.0"
        },
        "@nestjs/swagger": {
            "js-yaml": "5.4.1"
        }
    }
}